---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import '../styles/components/blog.scss';
import { t } from '../i18n/utils';
import { getCollection } from 'astro:content';
import { sortPostsByDate } from '../utils/posts';

const tr = t('en');
const posts = sortPostsByDate(await getCollection('posts', ({ data }) => data.locale === 'en'));

---

<BaseLayout
	title="Blog"
	description="Articles and notes by Leunel Aquino on LLMs, RAG, agents, embeddings, transformers and software development."
>
	<main class="container">
		<header class="blog-head">
			<h1 class="page-title">{tr.posts.title}</h1>
			<p class="section-label">{tr.posts.tickerAlt} ({posts.length})</p>
		</header>
		<div class="blog-grid">
			{posts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					date={`${tr.posts.postedOn} ${post.data.date}`}
					href={`/posts/${post.data.slug}`}
					cover={post.data.cover}
				/>
			))}
		</div>
	</main>
</BaseLayout>
