---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import Hero from '../components/Hero.astro';
import VectorSpace from '../components/VectorSpace.astro';
import '../styles/components/home.scss';
import { t } from '../i18n/utils';
import { getCollection } from 'astro:content';
import { sortPostsByDate } from '../utils/posts';

const tr = t('en');
const posts = await getCollection('posts', ({ data }) => data.locale === 'en');
const latestPosts = sortPostsByDate(posts).slice(0, 3);
---

<BaseLayout
	title="Leunel's website"
	description="Leunel Aquino — software developer building LLM, RAG and agent systems. Read my notes on AI engineering and explore my projects."
>
	<Hero locale="en" />
	<main class="container home-section">
		<p class="section-label">{tr.home.lastPosts}</p>
		<div class="home-posts">
			{latestPosts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					date={post.data.date}
					href={`/posts/${post.data.slug}`}
					cover={post.data.cover}
				/>
			))}
		</div>
		<a class="pill home-more" href="/posts/">{tr.home.allPosts} <span aria-hidden="true">&rarr;</span></a>
	</main>
	<section class="container home-section">
		<FeaturedProjects locale="en" />
	</section>
	<section class="container home-section concept-space">
		<p class="section-label">{tr.home.conceptSpace}</p>
		<VectorSpace locale="en" />
		<p class="concept-space__hint">{tr.home.conceptSpaceHint}</p>
	</section>
</BaseLayout>
