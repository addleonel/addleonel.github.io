---
import '../styles/components/header.scss';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocaleFromPath, t } from '../i18n/utils';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
const locale = getLocaleFromPath(currentPath);
const tr = t(locale);
const prefix = locale === 'en' ? '' : '/es';

const links = [
	{ href: `${prefix}/`, label: tr.nav.home },
	{ href: `${prefix}/posts/`, label: tr.nav.posts },
	{ href: `${prefix}/projects/`, label: tr.nav.projects },
	{ href: `${prefix}/about/`, label: tr.nav.about },
	{ href: `${prefix}/contact/`, label: tr.nav.contact },
];

// The top bar keeps the home link on the brand mark; the menu panel lists every page
const barLinks = links.slice(1);

const socials = [
	{ name: 'GitHub', href: 'https://github.com/addleonel' },
	{ name: 'LinkedIn', href: 'https://www.linkedin.com/in/leunel' },
	{ name: 'Instagram', href: 'https://www.instagram.com/addleonel/' },
	{ name: 'YouTube', href: 'https://www.youtube.com/@addleonel' },
];

const menuLabel = locale === 'es' ? 'Menú' : 'Menu';
const navigationLabel = locale === 'es' ? 'Navegación' : 'Navigation';

function isActive(linkHref: string, current: string): boolean {
	if (linkHref === '/' || linkHref === '/es/') {
		return current === linkHref || current === linkHref.slice(0, -1);
	}
	return current.startsWith(linkHref);
}
---

<header id="mainNav" class="site-header">
	<a class="brand" href={`${prefix}/`} aria-label="Leunel Aquino — home">
		<span class="brand__prompt" aria-hidden="true">&gt;</span>
		<span class="brand__name">leunel</span>
		<span class="brand__suffix" aria-hidden="true">/aquino</span>
		<span class="brand__caret" aria-hidden="true"></span>
		<img class="brand__logo" src="/favicon.svg" alt="" width="30" height="30" />
	</a>
	<nav class="site-header__nav" aria-label={navigationLabel}>
		<ul>
			{barLinks.map((link) => (
				<li>
					<a class:list={['site-header__link', { active: isActive(link.href, currentPath) }]} href={link.href}>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
	<div class="site-header__actions">
		<ThemeToggle locale={locale} />
		<LanguageSwitcher currentPath={currentPath} />
	</div>
</header>

<button class="menu-fab" type="button" aria-label={menuLabel} aria-expanded="false" aria-controls="menu-panel">
	<!-- 3×3 dots (the cube's front face); the diagonals become an X when open -->
	<span class="menu-fab__grid" aria-hidden="true">
		{Array.from({ length: 9 }, (_, i) => (
			<span
				class:list={['menu-fab__dot', { 'menu-fab__dot--diag': i % 2 === 0 }]}
				style={`--x:${(i % 3) - 1};--y:${Math.floor(i / 3) - 1}`}
			></span>
		))}
	</span>
</button>

<div class="menu-backdrop" aria-hidden="true"></div>
<aside id="menu-panel" class="menu-panel" aria-label={navigationLabel} aria-hidden="true">
	<div class="menu-panel__inner">
		<p class="menu-panel__label">{navigationLabel}</p>
		<ul class="menu-panel__links">
			{links.map((link) => (
				<li>
					<a class:list={['menu-panel__link', { active: isActive(link.href, currentPath) }]} href={link.href} tabindex="-1">
						{link.label}
					</a>
				</li>
			))}
		</ul>
		<div class="menu-panel__socials">
			<p class="menu-panel__label">Socials</p>
			<ul>
				{socials.map((s) => (
					<li><a href={s.href} target="_blank" rel="noopener noreferrer" tabindex="-1">{s.name}</a></li>
				))}
			</ul>
		</div>
	</div>
</aside>

<script>
	const fab = document.querySelector<HTMLButtonElement>('.menu-fab');
	const panel = document.getElementById('menu-panel');
	const backdrop = document.querySelector('.menu-backdrop');
	const header = document.getElementById('mainNav');

	if (fab && panel && header) {
		const panelLinks = panel.querySelectorAll<HTMLAnchorElement>('a');

		const setOpen = (open: boolean) => {
			document.documentElement.classList.toggle('menu-open', open);
			fab.setAttribute('aria-expanded', String(open));
			panel.setAttribute('aria-hidden', String(!open));
			panelLinks.forEach((a) => (a.tabIndex = open ? 0 : -1));
		};

		fab.addEventListener('click', () => {
			setOpen(!document.documentElement.classList.contains('menu-open'));
		});
		backdrop?.addEventListener('click', () => setOpen(false));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});

		// The round menu button takes over once the top bar scrolls out of view
		const io = new IntersectionObserver(([entry]) => {
			document.documentElement.classList.toggle('header-away', !entry.isIntersecting);
		});
		io.observe(header);
	}
</script>
