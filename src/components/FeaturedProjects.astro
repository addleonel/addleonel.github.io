---
import { projects } from '../data/resume';
import { t, type Locale } from '../i18n/utils';
import '../styles/components/featured-projects.scss';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const tr = t(locale);
const prefix = locale === 'en' ? '' : '/es';
const viewLabel = locale === 'es' ? 'Ver en GitHub' : 'View on GitHub';

// Curated set shown on the home page
const featuredNames = ['ventas.ai', 'yomismo.ia'];
const featured = featuredNames
	.map((name) => projects.find((p) => p.name === name))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<section class="featured-projects">
	<p class="section-label">{tr.home.featuredProjects}</p>

	<!-- Unfolding index: one row is open at a time; hover/focus opens a row,
	     on touch the first tap opens it and the second follows the link -->
	<ul class="work-index" data-work-index>
		{featured.map((p, i) => (
			<li class:list={['work-item', { 'is-open': i === 0 }]}>
				<a class="work-item__head" href={p.url} target="_blank" rel="noopener noreferrer" aria-expanded={i === 0 ? 'true' : 'false'}>
					<span class="work-item__num">{String(i + 1).padStart(2, '0')}</span>
					<h3 class="work-item__name">{p.name}</h3>
					<span class="work-item__tag">{p.tagline[locale]}</span>
					<span class="work-item__arrow" aria-hidden="true">&#8599;</span>
				</a>
				<div class="work-item__body">
					<div class="work-item__inner">
						<div class="work-item__text">
							<p class="work-item__desc">{p.description[locale]}</p>
							<ul class="work-item__tech">
								{p.tech.map((tech) => <li>{tech}</li>)}
							</ul>
							<a class="pill" href={p.url} target="_blank" rel="noopener noreferrer" tabindex="-1">
								{viewLabel} <span aria-hidden="true">&rarr;</span>
							</a>
						</div>
						<a class="work-item__media" href={p.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
							<img src={p.image} alt="" loading="lazy" />
							<span class="work-item__scan"></span>
						</a>
					</div>
				</div>
			</li>
		))}
	</ul>

	<a class="pill featured-projects__more" href={`${prefix}/projects/`}>{tr.home.allProjects} <span aria-hidden="true">&rarr;</span></a>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-work-index]').forEach((list) => {
		const items = [...list.querySelectorAll<HTMLElement>('.work-item')];
		const canHover = window.matchMedia('(hover: hover)').matches;

		const open = (item: HTMLElement) => {
			items.forEach((el) => {
				const isOpen = el === item;
				el.classList.toggle('is-open', isOpen);
				el.querySelector('.work-item__head')?.setAttribute('aria-expanded', String(isOpen));
				// Links inside a folded row stay out of the tab order
				el.querySelectorAll<HTMLAnchorElement>('.work-item__body a').forEach((a) => {
					a.tabIndex = isOpen ? 0 : -1;
				});
			});
		};

		items.forEach((item) => {
			if (canHover) item.addEventListener('mouseenter', () => open(item));
			item.addEventListener('focusin', () => open(item));
			// First tap on a folded row opens it instead of leaving the page
			item.querySelector('.work-item__head')?.addEventListener('click', (e) => {
				if (!item.classList.contains('is-open')) {
					e.preventDefault();
					open(item);
				}
			});
		});

		const initial = items.find((el) => el.classList.contains('is-open'));
		if (initial) open(initial);
	});
</script>
