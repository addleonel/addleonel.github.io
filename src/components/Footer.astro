		index: '(∞) Lo que sigue',
		title: 'Trabajemos juntos',
		hint: 'Prompts sugeridos',
		suggestions: ['Empecemos un proyecto', 'Tengo un puesto para ti', 'Colaboremos', 'Solo quería saludar'],
		cta: 'Hablemos',
		local: 'Hora local',
