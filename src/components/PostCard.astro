---
import '../styles/components/post-card.scss';

interface Props {
	title: string;
	description: string;
	date: string;
	href: string;
	cover?: string;
}

const { title, description, date, href, cover } = Astro.props;
---

<article class="post-card">
	<a class="post-card__link" href={href}>
		<div class="post-card__media">
			{cover ? (
				<img src={cover} alt={title} loading="lazy" />
			) : (
				<span class="post-card__placeholder" aria-hidden="true">{title.charAt(0)}</span>
			)}
		</div>
		<div class="post-card__body">
			<h3 class="post-card__title">{title}</h3>
			<p class="post-card__desc">{description}</p>
			<p class="post-card__meta">{date}</p>
		</div>
	</a>
</article>
